{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5434;Database=EngineerLogDb;Username=postgres;Password=YOUR_DB_PASSWORD_HERE"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS_HERE",
    "Issuer": "EngineerLogApi",
    "Audience": "EngineerLogClient",
    "ExpiryInMinutes": 60
  }
}
